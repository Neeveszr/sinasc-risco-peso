# Copie para .env (que NÃO vai para o Git) e ajuste os valores.
DB_URL=jdbc:postgresql://localhost:5432/sinasc
DB_USER=sinasc
DB_PASSWORD=sinasc

# OBRIGATÓRIA. Gere uma de verdade com:  openssl rand -hex 32
# A API não sobe se estiver vazia, com menos de 32 caracteres ou com valor de exemplo.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# Gestor/auditor inicial (opcional, criado só se ainda não existir).
# Defina uma senha forte de verdade (8 a 72 caracteres). Deixe ADMIN_PASSWORD vazio
# para não criar o gestor. A API ignora valores de exemplo.
ADMIN_EMAIL=gestor@exemplo.com
ADMIN_PASSWORD=

# Origens do front-end liberadas no CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Serviço Python do modelo (usado pela parte de predição).
MODEL_SERVICE_URL=http://localhost:8000
